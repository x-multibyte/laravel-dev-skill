{"$schema": "http://json-schema.org/draft-07/schema#", "$id": "https://laravel-dev.dev/schemas/preset-schema.json", "title": "Laravel Preset Schema", "description": "Laravel project preset configuration providing out-of-the-box solutions", "type": "object", "required": ["name", "version", "description", "laravel"], "properties": {"name": {"type": "string", "description": "Preset unique identifier (kebab-case)", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "examples": ["fullstack-app", "api-only", "realtime-app"]}, "version": {"type": "string", "description": "Preset version number (semantic versioning)", "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-zA-Z0-9.]+)?$", "examples": ["1.0.0", "2.1.3-beta"]}, "description": {"type": "string", "description": "Preset short description", "minLength": 10, "maxLength": 200}, "author": {"type": "string", "description": "Preset author or organization"}, "laravel": {"type": "object", "description": "Laravel framework configuration", "required": ["version"], "properties": {"version": {"type": "string", "description": "Laravel version requirement (Composer constraint format)", "examples": ["^12.0", ">=11.0", "12.*"]}, "strict": {"type": "boolean", "description": "Whether to strictly lock version", "default": false}}}, "dependencies": {"type": "object", "description": "Project dependencies configuration", "properties": {"composer": {"type": "object", "description": "Composer package dependencies", "additionalProperties": {"type": "string", "description": "Package version constraint"}}, "npm": {"type": "object", "description": "NPM package dependencies", "additionalProperties": {"type": "string", "description": "Package version constraint"}}}}, "dev_dependencies": {"type": "object", "description": "Development environment dependencies", "properties": {"composer": {"type": "object", "description": "Composer development dependencies"}, "npm": {"type": "object", "description": "NPM development dependencies"}}}, "database": {"type": "object", "description": "Database configuration", "properties": {"type": {"type": "string", "enum": ["mysql", "pgsql", "sqlite", "mongodb"], "description": "Database type"}, "version": {"type": "string", "description": "Database version requirement"}, "connection": {"type": "string", "description": "Laravel database connection name"}}}, "env_template": {"type": "object", "description": "Environment variable template (key-value pairs)", "additionalProperties": {"type": "string"}}, "auth": {"type": "object", "description": "Authentication scheme configuration", "properties": {"driver": {"type": "string", "enum": ["fortify", "sanctum", "passport", "session", "none"], "description": "Authentication driver"}, "features": {"type": "array", "description": "Enabled authentication features", "items": {"type": "string", "enum": ["2fa", "email-verification", "registration", "password-reset"]}}}}, "commands": {"type": "array", "description": "List of commands to execute after initialization", "items": {"type": "string", "description": "Shell command or Artisan command"}}, "hooks": {"type": "object", "description": "Lifecycle hook scripts", "properties": {"before_install": {"type": "array", "description": "Commands to execute before installation", "items": {"type": "string"}, "default": []}, "after_install": {"type": "array", "description": "Commands to execute after installation", "items": {"type": "string"}, "default": []}, "before_migration": {"type": "array", "description": "Commands to execute before migration", "items": {"type": "string"}, "default": []}, "after_migration": {"type": "array", "description": "Commands to execute after migration", "items": {"type": "string"}, "default": []}}}, "templates": {"type": "array", "description": "Template injection configuration", "items": {"type": "object", "required": ["source", "destination"], "properties": {"source": {"type": "string", "description": "Source template file path"}, "destination": {"type": "string", "description": "Destination file path"}, "overwrite": {"type": "boolean", "description": "Whether to overwrite existing files", "default": false}}}}, "extends": {"type": ["string", "null"], "description": "Parent preset name to inherit from (dependency inheritance)", "default": null}, "requires": {"type": "object", "description": "System requirements", "properties": {"php": {"type": "string", "description": "PHP version requirement"}, "composer": {"type": "string", "description": "Composer version requirement"}, "node": {"type": "string", "description": "Node.js version requirement"}, "docker": {"type": "boolean", "description": "Whether Docker is required"}}}, "metadata": {"type": "object", "description": "Metadata", "properties": {"tags": {"type": "array", "description": "Tags", "items": {"type": "string"}}, "category": {"type": "string", "description": "Category", "enum": ["basic", "fullstack", "api", "realtime", "custom"]}, "difficulty": {"type": "string", "description": "Difficulty level", "enum": ["beginner", "intermediate", "advanced"]}, "estimated_time": {"type": "string", "description": "Estimated initialization time"}}}}}