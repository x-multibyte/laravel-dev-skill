{"name": "livewire-starter", "version": "1.0.0", "description": "Laravel application with Livewire v3 for dynamic, reactive front-end without leaving PHP", "author": "laravel-dev", "laravel": {"version": "^10.0|^11.0|^12.0", "strict": false}, "dependencies": {"composer": {"livewire/livewire": "^3.0", "laravel/fortify": "^1.0", "spatie/laravel-permission": "^6.0|^7.0"}, "npm": {"@tailwindcss/forms": "^0.5", "@tailwindcss/typography": "^0.5", "alpinejs": "^3.0"}}, "dev_dependencies": {"composer": {"laravel/pint": "^1.0", "laravel/telescope": "^4.0|^5.0"}, "npm": {"@tailwindcss/vite": "^4.0", "autoprefixer": "^10.0", "postcss": "^8.0"}}, "database": {"type": "mysql", "version": "8.0", "connection": "mysql"}, "env_template": {"APP_NAME": "Laravel", "APP_ENV": "local", "APP_KEY": "", "APP_DEBUG": "true", "APP_URL": "http://localhost:8000", "LOG_CHANNEL": "stack", "LOG_DEPRECATIONS_CHANNEL": "null", "LOG_LEVEL": "debug", "DB_CONNECTION": "mysql", "DB_HOST": "127.0.0.1", "DB_PORT": "3306", "DB_DATABASE": "laravel", "DB_USERNAME": "root", "DB_PASSWORD": "", "BROADCAST_DRIVER": "log", "CACHE_DRIVER": "redis", "FILESYSTEM_DISK": "local", "QUEUE_CONNECTION": "redis", "SESSION_DRIVER": "file", "SESSION_LIFETIME": "120"}, "auth": {"driver": "fortify", "features": ["2fa", "email-verification", "registration", "password-reset"]}, "commands": ["php artisan fortify:install", "php artisan livewire:install --config", "php artisan migrate", "php artisan db:seed", "npm install", "npm run build"], "hooks": {"before_install": ["echo '⚡ Installing Livewire starter kit...'"], "after_install": ["php artisan key:generate", "php artisan config:clear"], "before_migration": [], "after_migration": ["php artisan cache:clear", "php artisan config:cache"]}, "templates": ["livewire"], "extends": null, "requires": {"php": ">=8.1", "composer": ">=2.0", "node": ">=18.0"}, "metadata": {"tags": ["livewire", "reactive", "php", "frontend"], "category": "starter-kit", "difficulty": "intermediate", "estimated